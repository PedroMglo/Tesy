  "C75_patch": "commit 27d2e42d8c994507ee6d71acc7c58d3eddd3f7a5\nAuthor:     PedroMglo <pedro.lourenco2001@hotmail.com>\nAuthorDate: Mon Sep 28 19:13:56 2026 +0100\nCommit:     PedroMglo <pedro.lourenco2001@hotmail.com>\nCommitDate: Mon Sep 28 19:13:56 2026 +0100\n\n    C75: port C57 parked MMID skip to C35 session backend\n    \n    Source semantics from b948e2d..aac3bbd; preserve broadcast activation conversion, write parked outputs, gate by TESY_CPU_WAVE_SKIP_PARKED. C48/C61/C66 failures remain historical; no model validation yet.\n\ndiff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c\nindex 8a0e5c2..b128bbf 100644\n--- a/ggml/src/ggml-cpu/ggml-cpu.c\n+++ b/ggml/src/ggml-cpu/ggml-cpu.c\n@@ -1622,6 +1622,15 @@ static void ggml_compute_forward_mul_mat_id(\n             for (int id = 0; id < n_ids; ++id) {\n                 const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);\n \n+#ifdef TESY_C47_CPU_SKIP_PARKED\n+                if (i02 == -1) {\n+                    // Shared activation conversion above still runs for all\n+                    // rows; an active ID may consume a broadcast row.\n+                    // Write the parked output so the graph keeps its shape.\n+                    memset((char *) dst->data + id*nb1 + iid1*nb2, 0, ne01*sizeof(float));\n+                    continue;\n+                }\n+#endif\n                 assert(i02 >= 0 && i02 < n_as);\n \n                 MMID_MATRIX_ROW(i02, matrix_row_counts[i02]) = (struct mmid_row_mapping) {id, iid1};\ndiff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp\nindex ce17396..fbbeafa 100644\n--- a/src/llama-moe-stream.cpp\n+++ b/src/llama-moe-stream.cpp\n@@ -809,6 +809,21 @@ void llama_moe_stream_wave_ids(ggml_tensor * dst, int ith, int nth, void * userd\n     sl->plan_next_wave = w + 1;\n \n     mgr->emit_wave_slots(*sl, ids, out, w, n_ids, a->ne[1]);\n+#ifdef TESY_C47_CPU_SKIP_PARKED\n+    if (std::getenv(\"TESY_CPU_WAVE_SKIP_PARKED\") != nullptr) {\n+        GGML_ASSERT(!sl->weights.empty() && sl->weights[0].cache != nullptr &&\n+                    sl->weights[0].cache->buffer != nullptr);\n+        // The stock CPU buffer type has no backend device; host accessibility\n+        // is the execution property used by the original C57 mechanism.\n+        if (ggml_backend_buffer_is_host(sl->weights[0].cache->buffer)) {\n+            for (int64_t i = 0; i < n; i++) {\n+                if (sl->expert_wave[ids[i]] != (uint8_t) w) {\n+                    out[i] = -1;\n+                }\n+            }\n+        }\n+    }\n+#endif\n }\n \n // multi-pass prefill: 1.0 for pairs whose expert belongs to wave w, 0.0 otherwise; multiplied into\n",
