{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "tesy-registry-v1"
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]{0,79}$"
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "kind": {
            "enum": [
              "campaign",
              "foundation",
              "dossier",
              "example"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "reports"
  ],
  "additionalProperties": false
}
