{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "tesy-sources-v1"
    },
    "repository": {
      "const": "PedroMglo/Tesy"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]{0,79}$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "git_blob_sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "availability": {
            "const": "TRACKED_SNAPSHOT"
          }
        },
        "required": [
          "id",
          "commit",
          "path",
          "sha256",
          "git_blob_sha1",
          "bytes",
          "availability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "repository",
    "sources"
  ],
  "additionalProperties": false
}
