+size_t llama_moe_stream::continuation_count_locked() const {
+    return std::count_if(continuations.begin(), continuations.end(),
+                         [](const attached_demand & d) { return d.work.sl != nullptr; });
+}
+
+// Called by the producer under mtx, immediately after complete() on this index.
+// complete(false) already discarded the failed entry. Copy/publish share the
+// path used by the waiting worker and execute only with both ownerships proven.
+bool llama_moe_stream::take_continuation_locked(int index, uint64_t ticket, bool read_ok,
+                                               llama_moe_stream_work & work) {
+    const auto saved = std::exchange(continuations.at(index), attached_demand{});
+    if (!saved.work.sl) return false;
+
+    work = saved.work;
+    auto & layer = *work.sl;
+    auto & stage = *prediction_stage;
+    const auto & entry = stage.entries.at(index);
+    const bool owns_source = stage.scope == saved.scope && saved.ticket == ticket &&
+        entry.scope == saved.scope && entry.ticket == ticket && entry.expert == work.expert &&
+        entry.call == work.trace_call && entry.layer == layer.il && entry.demand &&
+        !entry.expired && entry.status == c305_cpu_stage::READY;
+    const bool owns_dest = layer.slot_gen.at(work.slot) == work.gen &&
+        layer.slot_expert.at(work.slot) == work.expert &&
+        layer.slot_state.at(work.slot) == LLAMA_MOE_STREAM_SLOT_LOADING &&
+        layer.slot_claimed.at(work.slot);
+    if (!read_ok || !owns_source || !owns_dest || shutting_down || load_failed) {
+        if (owns_dest) layer.slot_claimed.at(work.slot) = 0;
+        if (owns_source) {
+            // No reader is in flight any longer; never free another ticket.
+            stage.record(4, index);
+            stage.entries.at(index) = {};
+        }
+        if (!shutting_down) load_failed = true;
+        ob::note("continuation_reject", work.expert, work.slot, work.gen, saved.ticket);
+        return false;
+    }
+    ob::note("handoff", work.expert, work.slot, work.gen, ticket);
+    return true;
+}
