// Uses the pinned four-slot Ring and Buffers from renewal/reader/native.cpp.
#include <map>
using Sequence = std::array<std::vector<Window>, 46>;
using Marks = std::array<uint64_t, 9>;

static Marks markers(const unsigned char *buf) {
    Marks result{};
    for (size_t component = 0; component < 3; ++component) {
        size_t k = 3 * component;
        for (size_t pos : {size_t(0), slab / 2, slab - sizeof(uint64_t)}) {
            std::memcpy(&result[k++], buf + component * slab + pos, sizeof(uint64_t));
        }
    }
    return result;
}

static int64_t elapsed(Clock::time_point begin) {
    return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - begin).count();
}

static auto work_file(const char *name, off_t bytes) {
    std::array<Sequence, 2> work{};
    std::map<off_t, Window> unique;
    std::ifstream file(name);
    int mode, call;
    Window w;
    while (file >> mode) {
        check(bool(file >> call >> w.offset >> w.expected[0] >> w.expected[1] >> w.expected[2]),
              "incomplete read plan");
        check(mode >= 0 && mode < 2 && call >= 1 && call <= 46 && w.offset >= 0 &&
              w.offset % 4096 == 0 && w.offset <= bytes - off_t(window), "plan extent");
        for (const auto &h : w.expected) check(h.size() == 64, "matrix digest");
        auto &step = work[mode][call-1];
        check(step.empty() || step.back().offset < w.offset, "duplicate/unsorted offset at step");
        step.push_back(w);
        const auto it = unique.try_emplace(w.offset, w).first;
        check(it->second.expected == w.expected, "conflicting matrix digests");
    }
    check(file.eof() && !unique.empty(), "invalid plan ending");
    for (int mode = 0; mode < 2; ++mode) {
        size_t count = 0;
        for (size_t c = 0; c < 46; ++c) {
            count += work[mode][c].size();
            if (c == 43) check(count == (mode ? 2514u : 768u), "first cut");
        }
        check(count == (mode ? 2662u : 788u), "terminal cut");
    }
    return std::make_pair(std::move(work), std::move(unique));
}

int main(int argc, char **argv) {
    try {
        check(argc == 3, "usage: reader PACK WINDOWS");
        const int fd = open(argv[1], O_RDONLY | O_DIRECT | O_CLOEXEC | O_NOFOLLOW);
        struct stat st{};
        check(fd >= 0 && (fcntl(fd, F_GETFL) & O_DIRECT) && fstat(fd, &st) == 0 &&
              S_ISREG(st.st_mode), "direct read-only source");
        std::cout << "fd " << st.st_dev << ' ' << st.st_ino << ' ' << st.st_size << ' '
                  << (st.st_mtim.tv_sec*1000000000LL + st.st_mtim.tv_nsec) << ' '
                  << (st.st_ctim.tv_sec*1000000000LL + st.st_ctim.tv_nsec) << std::endl;
        auto [work, unique] = work_file(argv[2], st.st_size);
        {
            Buffers b;
            Ring ring;
            Group g;
            std::map<off_t, Marks> expected;
            auto parity = Clock::now();
            for (const auto &[offset, w] : unique) {
                g.push_back(w);
                if (g.size() < lanes && offset != unique.rbegin()->first) continue;
                ring.read(fd, g, b);
                b.verify(g);
                for (size_t i = 0; i < g.size(); ++i)
                    expected.emplace(g[i].offset, markers(b.ptr[i]));
                g.clear();
            }
            check(expected.size() == unique.size(), "parity coverage");
            std::cout << "parity " << unique.size() << ' ' << elapsed(parity) << std::endl;
            size_t arm = 0;
            for (int mode : {0, 1, 1, 0}) {
                ++arm;
                for (size_t c = 0; c < work[mode].size(); ++c) {
                    const auto &step = work[mode][c];
                    auto begin = Clock::now();
                    int64_t read_ns = 0;
                    size_t batches = 0;
                    for (size_t j = 0; j < step.size(); j += lanes) {
                        const size_t n = std::min(size_t(lanes), step.size()-j);
                        g.assign(step.begin()+j, step.begin()+j+n);
                        auto rd = Clock::now();
                        ring.read(fd, g, b);
                        read_ns += elapsed(rd);
                        ++batches;
                        for (size_t k = 0; k < n; ++k)
                            check(markers(b.ptr[k]) == expected.at(g[k].offset), "timed bytes differ");
                    }
                    auto wall = elapsed(begin);
                    std::cout << "step " << arm << ' ' << mode << ' ' << c+1 << ' ' << step.size()
                              << ' ' << batches << ' ' << read_ns << ' ' << wall << '\n';
                }
                std::cout.flush();
            }
        }
        check(close(fd) == 0, "pack close");
        std::cout << "drained" << std::endl;
    } catch (const std::exception &e) {
        std::cerr << e.what() << std::endl;
        return 1;
    }
    return 0;
}
