+// Resolve the getter in the CPU provider already selected by this process.
+// R0 has no getter. The supervisor verifies presence against the provider SHA.
+struct RegionCounter {
+    using getter_t=uint64_t (*)();
+    std::string path;
+    void *handle=nullptr;
+    getter_t getter=nullptr;
+
+    RegionCounter() : path(provider(reinterpret_cast<void *>(&ggml_backend_cpu_init))) {
+        handle=dlopen(path.c_str(),RTLD_NOW|RTLD_NOLOAD);
+        need(handle!=nullptr,"CPU provider no longer loaded");
+        dlerror();
+        void *symbol=dlsym(handle,"tesy_parked_fusion_count");
+        const char *error=dlerror();
+        if (error) {
+            need(symbol==nullptr,"inconsistent getter lookup");
+        } else {
+            need(symbol!=nullptr && provider(symbol)==path,"wrong fusion counter provider");
+            getter=reinterpret_cast<getter_t>(symbol);
+        }
+    }
+    RegionCounter(const RegionCounter &)=delete;
+    RegionCounter &operator=(const RegionCounter &)=delete;
+    ~RegionCounter(){if(handle) dlclose(handle);}
+};
+
