// The production row views and the serial one-position control use separately allocated Q/masks.
#include "ggml.h"
#include "ggml-alloc.h"
#include "ggml-backend.h"
#include "ggml-cuda.h"

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <filesystem>
#include <fstream>
#include <stdexcept>
#include <thread>
#include <vector>

namespace fs = std::filesystem;
constexpr int dim = 64, heads = 64, kv_heads = 8, cap = 8192;
constexpr int qwords = dim * heads, kvwords = dim * kv_heads;

static void check(bool ok, const char *error) {
    if (!ok) throw std::runtime_error(error);
}

static float word(uint32_t index, uint32_t salt) {
    uint32_t x = index + salt;
    x ^= x >> 16;
    x *= 0x7feb352dU;
    x ^= x >> 15;
    x *= 0x846ca68bU;
    x ^= x >> 16;
    return (int(x & 2047U) - 1024) / 1024.0f;
}

struct Inputs {
    int n, position;
    std::vector<float> q, sinks;
    std::vector<ggml_fp16_t> k, v, mask;

    explicit Inputs(int width)
        : n(width), position(n == 2304 ? 2062 : n - 4), q(3*qwords), sinks(heads),
          k(n*kvwords), v(n*kvwords), mask(3*n) {
        for (size_t i=0; i<q.size(); ++i) q[i] = word(i, 1327);
        for (int i=0; i<heads; ++i) sinks[i] = word(i, 9931);
        for (size_t i=0; i<k.size(); ++i) {
            k[i] = ggml_fp32_to_fp16(word(i, 5011));
            v[i] = ggml_fp32_to_fp16(word(i, 7901));
        }
        for (int j=0; j<3; ++j)
            for (int i=0; i<n; ++i)
                mask[j*n+i] = i <= position+j ? 0 : 0xfc00;
    }
};

struct Graph {
    ggml_context *ctx = ggml_init({2 << 20, nullptr, true});
    ggml_backend_buffer_t storage = nullptr;
    Graph() { check(ctx != nullptr, "context"); }
    ~Graph() { if (storage) ggml_backend_buffer_free(storage); ggml_free(ctx); }
};

enum class Mode { Serial, Split, WrongMask };
static std::vector<float> evaluate(ggml_backend_t gpu, const Inputs &a, int first, Mode mode) {
    const int width = mode == Mode::Serial ? 1 : 3;
    Graph graph;
    auto *ctx0 = graph.ctx;
    auto *qb = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, dim, heads, width);
    auto *q = ggml_permute(ctx0, qb, 0, 2, 1, 3);
    auto *kq_mask = ggml_new_tensor_2d(ctx0, GGML_TYPE_F16, a.n, width);
    auto *sinks = ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, heads);
    auto *kb = ggml_new_tensor_2d(ctx0, GGML_TYPE_F16, kvwords, cap);
    auto *vb = ggml_new_tensor_2d(ctx0, GGML_TYPE_F16, kvwords, cap);
    auto cache = [&](ggml_tensor *t) {
        auto *view = ggml_view_4d(ctx0, t, dim, kv_heads, a.n, 1,
                                  dim*2, kvwords*2, cap*kvwords*2, 0);
        return ggml_permute(ctx0, view, 0, 2, 1, 3);
    };
    auto *k = cache(kb), *v = cache(vb);
    ggml_tensor *cur = nullptr;
    const float kq_scale = 0.125f;
    if (mode == Mode::Serial) {
        cur = ggml_flash_attn_ext(ctx0, q, k, v, kq_mask, kq_scale, 0.0f, 0.0f);
        ggml_flash_attn_ext_add_sinks(cur, sinks);
        ggml_flash_attn_ext_set_prec(cur, GGML_PREC_F32);
    } else {
        constexpr int il = 25;
@PRODUCTION_ROWS@
    }
    auto *g = ggml_new_graph_custom(ctx0, 64, false);
    ggml_build_forward_expand(g, cur);
    graph.storage = ggml_backend_alloc_ctx_tensors(ctx0, gpu);
    check(graph.storage && ggml_nbytes(cur) == width*qwords*sizeof(float), "allocation/shape");
    auto set = [](ggml_tensor *t, const void *p, size_t n) { ggml_backend_tensor_set(t,p,0,n); };
    set(qb, a.q.data()+first*qwords, width*qwords*sizeof(float));
    set(sinks, a.sinks.data(), heads*sizeof(float));
    if (mode == Mode::WrongMask) {
        auto wrong = a.mask;
        std::swap_ranges(wrong.begin(),wrong.begin()+a.n,wrong.begin()+2*a.n);
        set(kq_mask,wrong.data(),wrong.size()*2);
    } else {
        set(kq_mask, a.mask.data()+first*a.n, width*a.n*2);
    }
    // Serial and block caches have different bytes in uncommitted cells. Masks must hide them.
    const int valid = a.position + first + width;
    auto kv = [&](ggml_tensor *t, const std::vector<ggml_fp16_t> &src) {
        std::vector<ggml_fp16_t> active(a.n*kvwords, mode == Mode::Serial ? 0x3400 : 0xb800);
        std::copy_n(src.data(),valid*kvwords,active.data());
        set(t, active.data(), active.size()*2);
    };
    kv(kb, a.k);
    kv(vb, a.v);
    check(ggml_backend_graph_compute(gpu,g) == GGML_STATUS_SUCCESS, "compute");
    ggml_backend_synchronize(gpu);
    std::vector<float> result(width*qwords);
    ggml_backend_tensor_get(cur,result.data(),0,result.size()*sizeof(float));
    for (float f : result) check(std::isfinite(f), "nonfinite");
    return result;
}

static void save(const fs::path &p, const std::vector<float> &v) {
    FILE *f=std::fopen(p.c_str(),"wbx");
    check(f && std::fwrite(v.data(), sizeof(float), v.size(), f) == v.size(), "exclusive output");
    check(std::fclose(f)==0,"close");
}
static void stage(const fs::path &p, const char *s) {
    std::ofstream(p/(std::string(s)+".ready")) << s;
    const auto ack=p/(std::string(s)+".ack");
    for (int i=0; i<1000 && !fs::exists(ack); ++i) std::this_thread::sleep_for(std::chrono::milliseconds(10));
    check(fs::exists(ack),"GPU admission handshake");
}

int main(int argc, char **argv) try {
    check(argc==2,"fixture NEW_DIR");
    const fs::path root(argv[1]);
    check(fs::create_directory(root),"exclusive root");
    check(ggml_backend_cuda_get_device_count()==1,"one GPU");
    auto gpu=ggml_backend_cuda_init(0);
    check(gpu && ggml_backend_is_cuda(gpu),"CUDA");
    // Keep a real device allocation alive while the supervisor checks the CUDA owner.
    auto marker=ggml_backend_alloc_buffer(gpu,4096);
    check(marker && ggml_backend_buffer_get_base(marker), "live CUDA allocation");
    stage(root,"before");
    for (int n : {256,512,2048,2304,8192}) {
        Inputs a(n);
        auto out=root/std::to_string(n);
        check(fs::create_directory(out),"exclusive case");
        std::vector<float> ref;
        for (int j=0;j<3;++j) {
            auto row=evaluate(gpu,a,j,Mode::Serial);
            ref.insert(ref.end(),row.begin(),row.end());
        }
        auto actual=evaluate(gpu,a,0,Mode::Split);
        auto mutant=evaluate(gpu,a,0,Mode::WrongMask);
        save(out/"serial.f32",ref); save(out/"block.f32",actual); save(out/"mutant.f32",mutant);
        check(std::memcmp(ref.data(),actual.data(),ref.size()*4)==0,"serial/split mismatch");
        check(std::memcmp(ref.data(),mutant.data(),ref.size()*4)!=0,"mask mutation not detected");
    }
    stage(root,"after");
    ggml_backend_buffer_free(marker);
    ggml_backend_free(gpu);
    return 0;
} catch(const std::exception &e) {
    std::fprintf(stderr,"%s\n",e.what());
    return 1;
}
