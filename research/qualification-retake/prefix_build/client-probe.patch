+// Kept in this diagnostic client so the launcher cannot enable the observer.
+static void configure_prefix_observer(llama_moe_stream &service) {
+    if (const char *value = getenv("TESY_PREFIX_ROUTE_AUDIT")) {
+        check(std::string(value) == "1", "invalid prefix route audit option");
+        service.prefix_audit = std::make_unique<prefix_routes>();
+    }
+}
+
+static int probe_prefix_configuration() {
+    llama_moe_stream service(36, 40, 4, false);
+    const bool initially_off = !service.prefix_audit;
+    configure_prefix_observer(service);
+    check(initially_off && !service.workers_started && service.workers.empty() &&
+          service.q_demand.empty() && service.files.empty(), "startup probe opened work");
+    std::vector<std::string> mapped;
+    dl_iterate_phdr([](dl_phdr_info *info, size_t, void *data) {
+        if (info->dlpi_name && info->dlpi_name[0]) {
+            static_cast<std::vector<std::string> *>(data)->emplace_back(info->dlpi_name);
+        }
+        return 0;
+    }, &mapped);
+    std::cout << json({{"schema","tesy-prefix-build-probe-v1"},{"default_pointer_empty",initially_off},
+        {"enabled",bool(service.prefix_audit)},{"worker_count",service.workers.size()},
+        {"open_model_files",service.files.size()},{"mapped_objects",mapped}}).dump() << "\n";
+    return 0;
+}
