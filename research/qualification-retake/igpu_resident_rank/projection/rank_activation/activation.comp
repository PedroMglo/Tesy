#version 450
layout(local_size_x_id = 0) in;
layout(push_constant) uniform Parameters { uint ne; uint groups; } p;
layout(std430, binding = 0) readonly buffer Input { float values[]; } src;
layout(std430, binding = 1) writeonly buffer Output { float values[]; } dst;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 720u || p.ne != 2880u || p.groups != gl_NumWorkGroups.x) {
        return;
    }
    precise float x = min(src.values[i], 7.0);
    precise float y = clamp(src.values[720u + i], -7.0, 7.0);
    precise float power = 1.702 * (-x);
    precise float divisor = 1.0 + exp(power);
    precise float glu = x / divisor;
    precise float value = glu * (y + 1.0);
    dst.values[i] = value;
}
