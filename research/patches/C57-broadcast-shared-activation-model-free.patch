From aac3bbde35575044d290798a120cde038f85b670 Mon Sep 17 00:00:00 2001
From: PedroMglo <pedro.lourenco2001@hotmail.com>
Date: Mon, 28 Sep 2026 15:29:25 +0100
Subject: [PATCH] C57: preserve shared activation conversion for parked
 broadcast IDs

---
 ggml/src/ggml-cpu/ggml-cpu.c | 11 ++++-------
 1 file changed, 4 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index d524f9e..c362a12 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1605,13 +1605,10 @@ static void ggml_compute_forward_mul_mat_id(
         for (int64_t i13 = 0; i13 < ne13; ++i13) {
             for (int64_t i12 = 0; i12 < ne12; ++i12) {
                 for (int64_t i11 = 0; i11 < ne11; ++i11) {
-#ifdef TESY_C47_CPU_SKIP_PARKED
-                    const int32_t selected = *(const int32_t *) ((const char *) ids->data +
-                            i12*ids->nb[1] + i11*ids->nb[0]);
-                    if (selected == -1) {
-                        continue; // no quantized activation row is needed
-                    }
-#endif
+                    // src1 may be broadcast across several IDs. A parked ID at
+                    // this index does not imply that no active ID consumes the
+                    // converted activation row (id % ne11). Convert all rows;
+                    // the row mapping below still skips parked matmuls.
                     size_t bs = ggml_blck_size(vec_dot_type);
                     int64_t ne10_block_start = (ith * ne10/bs) / nth;
                     int64_t ne10_block_end   = ((ith + 1) * ne10/bs) / nth;
-- 
2.55.0

