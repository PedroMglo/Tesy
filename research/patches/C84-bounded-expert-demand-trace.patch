From 5a1f4c5d9ed06021d58813ffb41792e83f337513 Mon Sep 17 00:00:00 2001
From: PedroMglo <pedro.lourenco2001@hotmail.com>
Date: Mon, 28 Sep 2026 21:07:02 +0100
Subject: [PATCH] C84: add bounded expert demand trace diagnostic

---
 src/llama-moe-stream.cpp | 110 +++++++++++++++++++++++++++++++++++++--
 src/llama-moe-stream.h   |  23 +++++++-
 2 files changed, 128 insertions(+), 5 deletions(-)

diff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp
index fbbeafa..e06347e 100644
--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -146,6 +146,15 @@ llama_moe_stream::llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n
 
     debug         = std::getenv("LLAMA_MOE_STREAM_DEBUG") != nullptr;
     use_direct_io = direct;
+#ifdef TESY_C84_EXPERT_TRACE
+    if (const char * path = std::getenv("TESY_C84_EXPERT_TRACE_FILE")) {
+        trace_file = std::fopen(path, "wx"); // no replacement of an earlier diagnostic
+        if (trace_file == nullptr) {
+            throw std::runtime_error("C84 expert trace open failed");
+        }
+        trace_events.reserve(8192);
+    }
+#endif
 }
 
 // stop and join the I/O workers before the cache buffers and files they use are destroyed
@@ -159,7 +168,49 @@ llama_moe_stream::~llama_moe_stream() {
     for (auto & w : workers) {
         w.join();
     }
+#ifdef TESY_C84_EXPERT_TRACE
+    if (trace_file != nullptr) {
+        std::fprintf(trace_file, "#c84-expert-demand-v1\n");
+        std::fprintf(trace_file, "#layer\tlayer\tlogical_expert_bytes\tbuffer_name\n");
+        for (const auto & sl : layers) {
+            if (!sl || sl->weights.empty()) continue;
+            size_t bytes = 0;
+            for (const auto & wt : sl->weights) bytes += wt.nb_expert;
+            ggml_backend_buffer_t buffer = sl->weights[0].cache->buffer;
+            std::fprintf(trace_file, "L\t%d\t%zu\t%s\n", sl->il, bytes,
+                         buffer ? ggml_backend_buffer_name(buffer) : "UNALLOCATED");
+        }
+        std::fprintf(trace_file, "kind\tseq\tmono_us\tlayer\texpert\tslot\tvictim\tn_tokens\twave\tstate\tlogical_bytes\n");
+        for (const auto & e : trace_events) {
+            std::fprintf(trace_file, "%s\t%" PRIu64 "\t%" PRId64 "\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%" PRIu64 "\n",
+                         e.kind, e.seq, e.mono_us, e.layer, e.expert, e.slot,
+                         e.victim, e.n_tokens, e.wave, e.state, e.logical_bytes);
+        }
+        std::fprintf(trace_file, "#end\t%zu\t%d\n", trace_events.size(), trace_overflow ? 1 : 0);
+        const bool write_failed = std::ferror(trace_file) != 0;
+        if (std::fclose(trace_file) != 0 || write_failed) {
+            LLAMA_LOG_ERROR("C84 expert trace write failed\n");
+        }
+        trace_file = nullptr;
+    }
+#endif
+}
+
+#ifdef TESY_C84_EXPERT_TRACE
+void llama_moe_stream::trace_locked(const char * kind, int32_t layer, int32_t expert,
+                                    int32_t slot, int32_t victim, int32_t n_tokens,
+                                    int32_t wave, int32_t state, uint64_t logical_bytes,
+                                    int64_t mono_us) {
+    if (trace_file == nullptr || trace_overflow) return;
+    if (trace_events.size() >= trace_cap) {
+        trace_overflow = true;
+        return;
+    }
+    trace_events.push_back({ trace_events.size(), mono_us >= 0 ? mono_us : ggml_time_us(),
+                             kind, layer, expert, slot, victim, n_tokens, wave, state,
+                             logical_bytes });
 }
+#endif
 
 ggml_tensor * llama_moe_stream::create_cache_tensor(
         int32_t il, ggml_backend_buffer_type_t buft, const ggml_tensor * meta,
@@ -338,6 +389,9 @@ void llama_moe_stream::worker_loop() {
 
         lk.unlock();
 
+#ifdef TESY_C84_EXPERT_TRACE
+        const int64_t load_begin_us = ggml_time_us();
+#endif
         bool ok = true;
         for (const auto & wt : sl.weights) {
             const uint8_t * data = llama_moe_stream_pread(*files[wt.file_idx], staging, wt.nb_expert, wt.offs + (size_t) w.expert*wt.nb_expert, use_direct_io);
@@ -347,9 +401,21 @@ void llama_moe_stream::worker_loop() {
             }
             ggml_backend_tensor_set(wt.cache, data, (size_t) w.slot*wt.nb_expert, wt.nb_expert);
         }
+#ifdef TESY_C84_EXPERT_TRACE
+        const int64_t load_end_us = ggml_time_us();
+#endif
 
         lk.lock();
 
+#ifdef TESY_C84_EXPERT_TRACE
+        uint64_t logical_bytes = 0;
+        for (const auto & wt : sl.weights) logical_bytes += wt.nb_expert;
+        trace_locked("LOAD_BEGIN", sl.il, w.expert, w.slot, -1, 0, -1, -1,
+                     logical_bytes, load_begin_us);
+        trace_locked(ok ? "LOAD_END" : "LOAD_ERROR", sl.il, w.expert, w.slot,
+                     -1, 0, -1, -1, logical_bytes, load_end_us);
+#endif
+
         sl.slot_claimed[w.slot] = 0;
         if (!ok) {
             load_failed = true;
@@ -393,6 +459,10 @@ int32_t llama_moe_stream::pick_victim_locked(llama_moe_stream_layer & sl, const
 // in-flight load for the old occupant is recognized as stale), and update the expert_slot index
 void llama_moe_stream::reserve_slot_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot) {
     if (sl.slot_expert[slot] >= 0) {
+#ifdef TESY_C84_EXPERT_TRACE
+        trace_locked("EVICT", sl.il, sl.slot_expert[slot], slot, expert, 0, -1,
+                     sl.slot_state[slot]);
+#endif
         if (debug) {
             LLAMA_LOG_DEBUG("%s: layer %d: evict expert %d from slot %d\n", __func__, sl.il, sl.slot_expert[slot], slot);
         }
@@ -405,6 +475,9 @@ void llama_moe_stream::reserve_slot_locked(llama_moe_stream_layer & sl, int32_t
     sl.slot_last_use[slot] = ++sl.use_counter;
     sl.expert_slot[expert] = slot;
     sl.seen[expert] = 1;
+#ifdef TESY_C84_EXPERT_TRACE
+    trace_locked("RESERVE", sl.il, expert, slot);
+#endif
 }
 
 size_t llama_moe_stream::size_bufs() const {
@@ -501,6 +574,11 @@ void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, i
     bool waited = false;
     for (const int32_t e : sl->uniq) {
         const auto it = sl->expert_slot.find(e);
+#ifdef TESY_C84_EXPERT_TRACE
+        const int32_t trace_slot = it == sl->expert_slot.end() ? -1 : it->second;
+        mgr->trace_locked("DEMAND", sl->il, e, trace_slot, -1, a->ne[1], -1,
+                          trace_slot < 0 ? 0 : sl->slot_state[trace_slot]);
+#endif
         if (it != sl->expert_slot.end()) {
             const int32_t s = it->second;
             if (sl->slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
@@ -535,6 +613,10 @@ void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, i
 
     if (waited) {
         const int64_t t0 = ggml_time_us();
+#ifdef TESY_C84_EXPERT_TRACE
+        mgr->trace_locked("WAIT_BEGIN", sl->il, -1, -1, -1, a->ne[1], -1,
+                          -1, 0, t0);
+#endif
         mgr->cv_done.wait(lk, [&]{
             if (mgr->load_failed) {
                 return true;
@@ -549,7 +631,12 @@ void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, i
         if (mgr->load_failed) {
             GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
         }
-        mgr->stats.t_stall_us += ggml_time_us() - t0;
+        const int64_t t1 = ggml_time_us();
+        mgr->stats.t_stall_us += t1 - t0;
+#ifdef TESY_C84_EXPERT_TRACE
+        mgr->trace_locked("WAIT_END", sl->il, -1, -1, -1, a->ne[1], -1,
+                          -1, 0, t1);
+#endif
     }
 
     for (int64_t i = 0; i < n; i++) {
@@ -602,7 +689,7 @@ void llama_moe_stream::plan_waves_locked(llama_moe_stream_layer & sl, const int3
 // make wave w's expert slice (uniq[w*cap .. +count)) resident, waiting for its loads, and best-effort
 // preload the next wave so its loads overlap this wave's compute. leaves sl.demand_slots = this wave's
 // slots and sl.plan_pool = the resident parking pool (>= n_ids slots) the emit draws masked pairs from
-void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids) {
+void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids, int64_t n_tokens) {
     const size_t first = (size_t) w*sl.plan_capacity;
     const size_t count = first < sl.uniq.size() ? std::min<size_t>(sl.plan_capacity, sl.uniq.size() - first) : 0;
 
@@ -637,6 +724,11 @@ void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llam
         for (size_t i = first; i < first + count; i++) {
             const int32_t e  = sl.uniq[i];
             const auto    it = sl.expert_slot.find(e);
+#ifdef TESY_C84_EXPERT_TRACE
+            const int32_t trace_slot = it == sl.expert_slot.end() ? -1 : it->second;
+            trace_locked("DEMAND", sl.il, e, trace_slot, -1, n_tokens, w,
+                         trace_slot < 0 ? 0 : sl.slot_state[trace_slot]);
+#endif
             if (it != sl.expert_slot.end()) {
                 // already in the cache (resident, or still loading from the previous wave's preload)
                 const int32_t s = it->second;
@@ -689,6 +781,9 @@ void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llam
                 stats.n_miss_cold++;
             }
             reserve_slot_locked(sl, e, v);
+#ifdef TESY_C84_EXPERT_TRACE
+            trace_locked("PRELOAD", sl.il, e, v, -1, n_tokens, w + 1);
+#endif
             sl.keep[v] = 1;
             q_demand.push_back({ &sl, e, v, sl.slot_gen[v] });
             cv_work.notify_one();
@@ -698,6 +793,9 @@ void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llam
 
     if (waited) {
         const int64_t t0 = ggml_time_us();
+#ifdef TESY_C84_EXPERT_TRACE
+        trace_locked("WAIT_BEGIN", sl.il, -1, -1, -1, n_tokens, w, -1, 0, t0);
+#endif
         cv_done.wait(lk, [&]{
             if (load_failed) {
                 return true;
@@ -712,7 +810,11 @@ void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llam
         if (load_failed) {
             GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
         }
-        stats.t_stall_wave_us += ggml_time_us() - t0;
+        const int64_t t1 = ggml_time_us();
+        stats.t_stall_wave_us += t1 - t0;
+#ifdef TESY_C84_EXPERT_TRACE
+        trace_locked("WAIT_END", sl.il, -1, -1, -1, n_tokens, w, -1, 0, t1);
+#endif
     }
 
     // parking pool: this wave's own resident slots plus the borrowed ones (all keep-protected;
@@ -805,7 +907,7 @@ void llama_moe_stream_wave_ids(ggml_tensor * dst, int ith, int nth, void * userd
 
     const uint32_t n_ids = (uint32_t) a->ne[0]; // experts per token (n_expert_used)
 
-    mgr->stage_wave_locked(lk, *sl, w, n_ids); // make this wave resident, preload the next, build the pool
+    mgr->stage_wave_locked(lk, *sl, w, n_ids, a->ne[1]); // make wave resident, preload next
     sl->plan_next_wave = w + 1;
 
     mgr->emit_wave_slots(*sl, ids, out, w, n_ids, a->ne[1]);
diff --git a/src/llama-moe-stream.h b/src/llama-moe-stream.h
index 95032fa..426c74c 100644
--- a/src/llama-moe-stream.h
+++ b/src/llama-moe-stream.h
@@ -5,6 +5,7 @@
 #include "ggml-cpp.h"
 
 #include <condition_variable>
+#include <cstdio>
 #include <cstdint>
 #include <deque>
 #include <memory>
@@ -164,6 +165,26 @@ struct llama_moe_stream {
 
     bool debug = false;
 
+#ifdef TESY_C84_EXPERT_TRACE
+    // Diagnostic only. Events are bounded in RAM and written once at clean destruction.
+    // The mutex already guarding streaming state also orders demand/eviction records.
+    struct trace_event {
+        uint64_t seq;
+        int64_t  mono_us;
+        const char * kind;
+        int32_t layer, expert, slot, victim, n_tokens, wave, state;
+        uint64_t logical_bytes;
+    };
+    FILE * trace_file = nullptr;
+    std::vector<trace_event> trace_events;
+    bool trace_overflow = false;
+    static constexpr size_t trace_cap = 300000;
+    void trace_locked(const char * kind, int32_t layer, int32_t expert = -1,
+                      int32_t slot = -1, int32_t victim = -1, int32_t n_tokens = 0,
+                      int32_t wave = -1, int32_t state = -1, uint64_t logical_bytes = 0,
+                      int64_t mono_us = -1);
+#endif
+
     struct {
         int64_t n_calls     = 0; // remap invocations
         int64_t n_hit       = 0; // touched experts already resident or loading
@@ -186,7 +207,7 @@ struct llama_moe_stream {
 
     // multi-pass prefill helpers (called by llama_moe_stream_wave_ids, all under mtx)
     void plan_waves_locked(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n); // wave 0: build the plan
-    void stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids); // make wave w resident + preload next
+    void stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids, int64_t n_tokens); // make wave w resident + preload next
     void emit_wave_slots(llama_moe_stream_layer & sl, const int32_t * ids, int32_t * out, int32_t w, uint32_t n_ids, int64_t n_tok); // write the slot ids
 };
 
-- 
2.55.0

