+#endif
+
@@ -342,0 +350,3 @@ void llama_moe_stream::worker_loop() {
+#ifdef TESY_C15_NVTX
+            nvtxRangePushA("C15_EXPERT_PREAD");
+#endif
@@ -343,0 +354,3 @@ void llama_moe_stream::worker_loop() {
+#ifdef TESY_C15_NVTX
+            nvtxRangePop();
+#endif
@@ -347,0 +361,3 @@ void llama_moe_stream::worker_loop() {
+#ifdef TESY_C15_NVTX
+            nvtxRangePushA("C15_EXPERT_UPLOAD");
+#endif
@@ -348,0 +365,3 @@ void llama_moe_stream::worker_loop() {
+#ifdef TESY_C15_NVTX
+            nvtxRangePop();
+#endif
@@ -430,0 +450,4 @@ void llama_moe_stream::print_stats() const {
+#ifdef TESY_C15_NVTX
+    LLAMA_LOG_INFO("%s: C15 wave pairs active = %" PRIu64 ", all = %" PRIu64 "\n",
+            __func__, c15_active_pairs.load(std::memory_order_relaxed), c15_all_pairs.load(std::memory_order_relaxed));
+#endif
@@ -811,0 +835,8 @@ void llama_moe_stream_wave_ids(ggml_tensor * dst, int ith, int nth, void * userd
+#ifdef TESY_C15_NVTX
+    uint64_t active = 0;
+    for (int64_t i = 0; i < n; i++) {
+        active += sl->expert_wave[ids[i]] == (uint8_t) w;
+    }
+    c15_active_pairs.fetch_add(active, std::memory_order_relaxed);
+    c15_all_pairs.fetch_add((uint64_t) n, std::memory_order_relaxed);
+#endif
