diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 8a0e5c2..273bf87 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -17,0 +18,4 @@
+#ifdef TESY_C15_NVTX
+#include <nvtx3/nvToolsExt.h>
+#endif
+
@@ -3060,0 +3065,10 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
+#ifdef TESY_C15_NVTX
+        // ith 0 spans the whole CPU node, including the barrier with worker threads.
+        // Streamed expert MMID weights have exactly the frozen slot count in ne[2].
+        const bool c15_mmid = state->ith == 0 && node->op == GGML_OP_MUL_MAT_ID &&
+                              node->src[0] != NULL && node->src[0]->ne[2] == 32;
+        if (c15_mmid) {
+            nvtxRangePushA("C15_CPU_STREAM_MATMUL_ID");
+        }
+#endif
+
@@ -3078,0 +3093,5 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
+#ifdef TESY_C15_NVTX
+        if (c15_mmid) {
+            nvtxRangePop();
+        }
+#endif
diff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp
index ce17396..5faad79 100644
--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -12,0 +13,7 @@
+#ifdef TESY_C15_NVTX
+#include <atomic>
+#include <nvtx3/nvToolsExt.h>
+static std::atomic<uint64_t> c15_active_pairs {0};
