+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <vector>
+#include "ggml.h"
+// Bounded diagnostic events. Serialize only after all workers have drained.
+struct c294_event {
+    int64_t us=0, call=0, route=0, bytes=0;
+    uint64_t gen=0;
+    int kind=0, layer=-1, expert=-1, slot=-1, component=-1, rows=0;
+};
+struct c294_window {
+    static constexpr size_t capacity=131072;
+    std::vector<c294_event> events;
+    std::atomic<size_t> count{0};
+    std::atomic<bool> enabled{false}, overflow{false};
+    std::atomic<int64_t> call{0};
+    int64_t next_route=0; // existing manager mutex
+    c294_window():events(capacity) {}
+    void record(int kind,int layer=-1,int expert=-1,int slot=-1,uint64_t gen=0,
+                int64_t route=0,int component=-1,int64_t bytes=0,int rows=0,int64_t owner=-1) {
+        if (!enabled.load(std::memory_order_relaxed)) return;
+        const size_t i=count.fetch_add(1,std::memory_order_relaxed);
+        if(i>=capacity){overflow.store(true);return;}
+        events[i]={ggml_time_us(),owner<0?call.load():owner,route,bytes,gen,kind,layer,expert,slot,component,rows};
+    }
+};
+// kinds: 1 feature, 2 router, 3 demand-state, 4 enqueue, 5 dequeue,
+// 6/7 read begin/end, 8/9 tensor_set begin/end, 10 commit,
+// 11/12 wait begin/end, 13/14 remap begin/end, 15/16 call begin/end.
