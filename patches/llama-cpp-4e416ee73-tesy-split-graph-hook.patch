+// Internal experimental surface only; deliberately absent from llama.h.
+extern "C" LLAMA_API void llama_tesy_set_graph_compute_hook(
+        llama_context * ctx,
+        ggml_status (* hook)(ggml_cgraph *, ggml_backend_sched_t, ggml_backend_t, void *),
+        void * user_data) {
+    ctx->tesy_set_graph_compute_hook(hook, user_data);
