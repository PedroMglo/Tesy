+void llama_context::tesy_set_graph_compute_hook(
+        ggml_status (* hook)(ggml_cgraph *, ggml_backend_sched_t, ggml_backend_t, void *),
+        void * user_data) {
+    tesy_graph_compute_hook = hook;
+    tesy_graph_compute_user_data = user_data;
+}
