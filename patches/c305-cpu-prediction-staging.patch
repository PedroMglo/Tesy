--- /dev/null
+++ b/src/c305-cpu-stage.h
@@ -0,0 +1,160 @@
+#pragma once
+#include "c291-direct-reader.h"
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <chrono>
+#include <stdexcept>
+
+// All state transitions require the stream manager mutex. IO owns its entry
+// until completion; expiry never frees a buffer still being read or consumed.
+struct c305_cpu_stage {
+    static constexpr size_t arena_limit=128*1024*1024, slab=4406400;
+    static constexpr int slots=10;
+    enum state { EMPTY, QUEUED, READING, READY, CONSUMING };
+    struct entry {
+        state status=EMPTY;
+        uint64_t scope=0, ticket=0;
+        int call=0, layer=-1, expert=-1;
+        bool expired=false, demand=false;
+        std::array<size_t,3> head{};
+    };
+    struct event {
+        int64_t us=0; uint64_t scope=0,ticket=0,generation=0;
+        int kind=0,call=0,layer=-1,expert=-1,slot=-1,component=-1;
+    };
+    static constexpr size_t journal_capacity=24576;
+    std::array<event,journal_capacity> journal{}; size_t journal_count=0;
+    bool journal_enabled=false,validate=false;
+    void record(int kind,int i,int slot=-1,uint64_t gen=0,int component=-1) {
+        if(!journal_enabled)return;
+        require(journal_count<journal_capacity,"stage journal overflow");
+        const auto&e=entries.at(i);
+        const auto us=std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        journal[journal_count++]={us,e.scope,e.ticket,gen,kind,e.call,e.layer,e.expert,slot,component};
+    }
+    struct counters {
+        uint64_t issued=0, deduplicated=0, no_capacity=0, reads=0, completed_reads=0, read_bytes=0;
+        uint64_t expired_queued=0, expired_ready=0, expired_running=0;
+        uint64_t consumed=0, waits=0, errors=0, peak_running_spec=0;
+        uint64_t validation_components=0,validation_claims=0;
+    } stats;
+    tesy_witness::direct_reader reader;
+    std::array<std::array<uint64_t,3>,36> offsets{};
+    std::array<entry,slots> entries{};
+    std::unique_ptr<uint8_t,decltype(&std::free)> arena{nullptr,&std::free};
+    size_t component_stride=0, entry_stride=0;
+    uint64_t scope=0, serial=0;
+    int running=0;
+    bool enabled=false;
+    static void require(bool good,const char * why){if(!good)throw std::runtime_error(why);}
+    #ifdef TESY_C305_STAGE_TESTING
+    c305_cpu_stage()=default; // queue fault fixtures only; absent from runtime build
+    #endif
+
+    c305_cpu_stage(const char *path,const std::array<std::array<uint64_t,3>,36>& source):offsets(source) {
+        reader.open_file(path);
+        const size_t a=std::max(reader.memory_alignment(),reader.offset_alignment());
+        require(a && !(a&(a-1)) && a<=1024*1024,"stage DIO alignment unsupported");
+        component_stride=(slab+2*a+a-1)/a*a;
+        entry_stride=3*component_stride;
+        require(entry_stride*slots+sizeof(*this)<=arena_limit,"128MiB stage arena accounting exceeded");
+        void *p=nullptr;require(!posix_memalign(&p,a,entry_stride*slots),"stage arena allocation failed");
+        arena.reset(static_cast<uint8_t*>(p));std::memset(p,0,entry_stride*slots);
+        for(int l=2;l<=24;l++)for(int k=0;k<3;k++){
+            require(offsets[l][k]<=UINT64_MAX-128*slab,"stage metadata offset overflow");
+            reader.validate_range(offsets[l][k],128*slab);
+        }
+    }
+    uint8_t *component(int i,int k) {
+        require(bool(arena),"stage byte arena absent");
+        require(i>=0&&i<slots&&k>=0&&k<3,"stage component index");
+        return arena.get()+size_t(i)*entry_stride+size_t(k)*component_stride;
+    }
+    int find(int call,int layer,int expert) const {
+        for(int i=0;i<slots;i++){const auto&e=entries.at(i);if(e.status!=EMPTY&&!e.expired&&e.scope==scope&&e.call==call&&e.layer==layer&&e.expert==expert)return i;}
+        return -1;
+    }
+    bool idle() const {
+        return running==0&&std::all_of(entries.begin(),entries.end(),[](const entry&e){return e.status==EMPTY;});
+    }
+    void begin(bool active) {
+        require(idle()&&scope<UINT64_MAX,"stage scope reset while buffers live");
+        scope++;enabled=active;stats={};journal_count=0;
+    }
+    int request(int call,int layer,int expert) {
+        require(call>=1&&call<=32&&layer>=2&&layer<=24&&expert>=0&&expert<128,"stage request scope");
+        if(!enabled)return -1;
+        int old=find(call,layer,expert);if(old>=0){stats.deduplicated++;return old;}
+        for(int i=0;i<slots;i++)if(entries.at(i).status==EMPTY){
+            require(serial<UINT64_MAX,"stage ticket overflow");
+            entries.at(i)={};auto&e=entries.at(i);e.status=QUEUED;e.scope=scope;e.ticket=++serial;e.call=call;e.layer=layer;e.expert=expert;stats.issued++;record(1,i);return i;
+        }
+        stats.no_capacity++;return -1;
+    }
+    int speculative_running() const {
+        return int(std::count_if(entries.begin(),entries.end(),[](const entry&e){return e.status==READING&&!e.demand;}));
+    }
+    int next() const {
+        if(!enabled||speculative_running()>=3)return -1;
+        int best=-1;for(int i=0;i<slots;i++)if(entries.at(i).status==QUEUED&&!entries.at(i).expired&&(best<0||entries.at(i).ticket<entries[best].ticket))best=i;
+        return best;
+    }
+    uint64_t start(int i) {
+        require(i==next()&&i>=0,"stage dispatch violates demand worker reserve");
+        auto&e=entries.at(i);e.status=READING;running++;
+        stats.peak_running_spec=std::max(stats.peak_running_spec,uint64_t(speculative_running()));record(2,i);return e.ticket;
+    }
+    // Caller owns this entry; no state mutation or mutex while positional reads run.
+    void read(int i,uint64_t ticket,tesy_witness::direct_reader::read_fn fn=::pread) {
+        const auto&e=entries.at(i);require(e.status==READING&&e.ticket==ticket,"stage read owner stale");
+        for(int k=0;k<3;k++){
+            const auto off=offsets[e.layer][k]+uint64_t(e.expert)*slab;
+            const size_t a=reader.offset_alignment(),head=off%a;
+            const uint64_t begin=off-head,amount=(head+slab+a-1)/a*a;
+            auto *out=component(i,k);
+            require(amount<=component_stride&&reinterpret_cast<uintptr_t>(out)%reader.memory_alignment()==0,"stage aligned window bound");
+            require(begin<=uint64_t(std::numeric_limits<off_t>::max())-amount,"stage aligned off_t overflow");
+            ssize_t n;do{n=fn(reader.descriptor(),out,amount,off_t(begin));}while(n<0&&errno==EINTR);
+            require(n>=0&&size_t(n)>=head+slab,"stage direct IO failed/short; no fallback");
+        }
+    }
+    void complete(int i,uint64_t ticket,bool ok) {
+        auto&e=entries.at(i);require(e.status==READING&&e.ticket==ticket&&running>0,"late stage completion ownership");
+        running--;stats.reads++;stats.read_bytes+=3*slab;
+        if(!ok){stats.errors++;record(9,i);e={};return;}
+        stats.completed_reads++;record(3,i);
+        if(arena)for(int k=0;k<3;k++)e.head[k]=(offsets[e.layer][k]+uint64_t(e.expert)*slab)%reader.offset_alignment();
+        if(e.expired&&!e.demand){stats.expired_running++;record(4,i);e={};}else e.status=READY;
+    }
+    void cancel(int i) {
+        auto&e=entries.at(i);if(e.status==EMPTY||e.demand||e.status==CONSUMING)return;
+        if(e.status==QUEUED){stats.expired_queued++;record(4,i);e={};}
+        else if(e.status==READY){stats.expired_ready++;record(4,i);e={};}
+        else if(e.status==READING&&!e.expired){record(5,i);e.expired=true;}
+    }
+    void expire(int call,int layer,const int32_t *ids,size_t n) {
+        for(int i=0;i<slots;i++){auto&e=entries.at(i);if(e.status!=EMPTY&&e.scope==scope&&e.call==call&&e.layer==layer&&std::find(ids,ids+n,e.expert)==ids+n)cancel(i);}
+    }
+    void finish() {
+        enabled=false;for(int i=0;i<slots;i++)cancel(i);
+    }
+    // True demand attaches only after reserving/claiming the authoritative slot.
+    bool demand(int i,uint64_t ticket) {
+        auto&e=entries.at(i);require(!e.expired&&e.ticket==ticket&&e.scope==scope,"stage demand generation stale");
+        if(e.status==QUEUED){record(4,i);e={};return false;} // normal demand read has priority
+        require(e.status==READING||e.status==READY,"duplicate stage consumer");
+        e.demand=true;record(6,i);return true;
+    }
+    void claim(int i,uint64_t ticket) {
+        auto&e=entries.at(i);require(e.status==READY&&e.ticket==ticket&&e.demand&&!e.expired,"stage not ready at consumer");e.status=CONSUMING;
+    }
+    const uint8_t *bytes(int i,int k,uint64_t ticket) {
+        const auto&e=entries.at(i);require(e.status==CONSUMING&&e.ticket==ticket&&e.demand,"stage buffer lifetime invalid");return component(i,k)+e.head[k];
+    }
+    void release(int i,uint64_t ticket) {
+        auto&e=entries.at(i);require(e.status==CONSUMING&&e.ticket==ticket,"stage release stale");stats.consumed++;record(8,i);e={};
+    }
+};
