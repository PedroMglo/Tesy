+    #endif
+    tesy_expert_store(const char *manifest,const std::string &original,const std::vector<std::unique_ptr<llama_moe_stream_layer>>& layers):original_path(original){
+        const auto m=metadata(manifest);require(m.at("schema")=="tesy-integral-expert-store-runtime-v1" && m.at("canonical_model_sha256")=="582bd40f6886200101f4c4ed9f25f3fe80cc14c86e9e2b37746cd8904a0c622d","store model/manifest identity");
+        const std::string index_path=m.at("index_path");require(identity(index_path.c_str())==m.at("index_stat"),"store index stat changed");const auto index=metadata(index_path);require(identity(index_path.c_str())==m.at("index_stat"),"store index changed during parse");
+        require(index.at("store_scope")=="INTEGRAL_GPT_OSS120B_36x128" && index.at("experts").size()==4608 && layers.size()==36,"integral store layer/expert scope");
+        original_identity=identity(original.c_str());require(original_identity==m.at("model_stat") && original_identity==index.at("model_stat"),"store canonical model stat changed");
+        const std::string path=index.at("pack_path");pack_identity=identity(path.c_str());require(pack_identity==m.at("pack_stat") && index.at("pack_sha256_write_stream")==m.at("pack_sha256_write_stream"),"store pack stat/provenance changed");
+        struct stat st{};require(stat(path.c_str(),&st)==0 && !(st.st_mode&0222),"store payload must be readonly");data.open_file(path.c_str());
+        require(data.memory_alignment()<=4096 && data.offset_alignment()<=4096 && 4096%data.memory_alignment()==0 && 4096%data.offset_alignment()==0,"store DIO requirement exceeds qualified worker alignment");
+        const uint64_t stride=index.at("stride");require(stride>=weights && stride%data.offset_alignment()==0 && stride*4608==data.file_size() && data.file_size()<=80ull*1024*1024*1024,"integral store size/alignment");
+        for(size_t l=0;l<36;l++){
+            require(layers[l] && layers[l]->n_expert==128 && layers[l]->n_slots==40 && layers[l]->weights.size()==3,"unsupported store primary pools");
+            const auto &sl=*layers[l];
+            for(size_t e=0;e<128;e++){
+                const auto &row=index.at("experts").at(l*128+e);require(row.at("layer")==l && row.at("expert")==e && row.at("components").size()==6 && row.at("pack_offset")==stride*(l*128+e),"store expert mapping changed");
+                auto &entry=entries[l][e];entry.offset=row.at("pack_offset");data.validate_range(entry.offset,weights);
+                for(size_t k=0;k<3;k++){
+                    const auto &wt=sl.weights[k];const auto &c=row.at("components").at(k);std::string name=ggml_get_name(wt.cache);const std::string suffix=".stream_cache";
+                    require(name.size()>suffix.size() && name.substr(name.size()-suffix.size())==suffix,"store cache tensor name");name.resize(name.size()-suffix.size());
+                    require(wt.file_idx==0 && wt.nb_expert==slab && wt.cache->type==GGML_TYPE_MXFP4 && wt.cache->ne[0]==2880 && wt.cache->ne[1]==2880 && wt.cache->nb[2]==slab && c.at("name")==name && c.at("type")=="mxfp4" && c.at("size_bytes")==slab && c.at("source_offset")==wt.offs+e*slab && c.at("packed_relative_offset")==k*slab,"store component/native tensor mapping changed");entry.relative[k]=c.at("packed_relative_offset");
+                }
+            }
+        }
+    }
+    const uint8_t *read(size_t layer,size_t expert,uint8_t *staging,tesy_witness::direct_reader::read_fn fn=::pread)const{
+        require(layer<36 && expert<128 && staging,"store request identity");const auto &r=entries[layer][expert];data.validate_range(r.offset,weights);const uint64_t a=data.offset_alignment();require(r.offset%a==0,"store expert alignment");const size_t amount=(weights+a-1)/a*a;require(amount<=staging_bytes,"store staging bound");ssize_t n;do{n=fn(data.descriptor(),staging,amount,off_t(r.offset));}while(n<0&&errno==EINTR);require(n>=0 && size_t(n)>=weights,"store read failed/short; no buffered fallback");return staging;
+    }
+};
+// A queued work identity must still own its reservation when publication occurs.
+inline bool tesy_store_completion_valid(bool cancelled,bool ok,uint64_t expected_generation,uint64_t actual_generation,int expected_expert,int actual_expert,int state,bool claimed){return !cancelled && ok && expected_generation==actual_generation && expected_expert==actual_expert && state==LLAMA_MOE_STREAM_SLOT_LOADING && claimed;}
