@@ -0,0 +1,46 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+// Selected routing rows only. Canonical IDs affect accounting, never compute order.
+struct c284_route_clock {
+    uint64_t rows=0, decay_epoch=0, event=0, lifecycle=0;
+    int32_t sequence=-1;
+    std::vector<int32_t> positions;
+    std::vector<std::array<int32_t,4>> accounted;
+    size_t cursor=0;
+    void reset(uint64_t life, int32_t seq, std::vector<uint32_t> & hot) {
+        rows=decay_epoch=event=0; lifecycle=life; sequence=seq;
+        positions.clear();accounted.clear();cursor=0;std::fill(hot.begin(),hot.end(),0);
+    }
+    void begin(uint64_t serial, const std::vector<int32_t> & pos) {
+        if(cursor!=positions.size() || serial<=event || pos.size()>256) throw std::runtime_error("logical incomplete/stale/unbounded event");
+        for(int32_t p:pos)if(p<0||p>=8192)throw std::runtime_error("logical position invalid");
+        event=serial;positions=pos;cursor=0;accounted.assign(pos.size(),{{-1,-1,-1,-1}});
+    }
+    // Repeat consumption of an identical event/range is idempotent. Reevaluation uses begin(new serial).
+    bool consume_at(size_t first, const int32_t * ids, size_t count, std::vector<uint32_t> & hot) {
+        if(first>positions.size()||count>positions.size()-first||(!ids&&count))throw std::runtime_error("logical range invalid");
+        std::vector<std::array<int32_t,4>> canonical(count);
+        for(size_t i=0;i<count;i++) {
+            std::copy_n(ids+i*4,4,canonical[i].begin());std::sort(canonical[i].begin(),canonical[i].end());
+            for(size_t k=0;k<4;k++)if(canonical[i][k]<0||size_t(canonical[i][k])>=hot.size()||(k&&canonical[i][k]==canonical[i][k-1]))throw std::runtime_error("logical top-k invalid/duplicate");
+        }
+        if(first<cursor) {
+            if(count>cursor-first)throw std::runtime_error("logical partial duplicate");
+            for(size_t i=0;i<count;i++)if(accounted[first+i]!=canonical[i])throw std::runtime_error("logical duplicate changed routing");
+            return false;
+        }
+        if(first!=cursor||count>std::numeric_limits<uint64_t>::max()-rows)throw std::runtime_error("logical order/overflow");
+        for(size_t i=0;i<count;i++) {
+            for(int32_t e:canonical[i])if(hot[e]<UINT32_MAX-1)++hot[e];
+            ++rows;if(rows%64==0){for(auto & h:hot)h>>=1;++decay_epoch;}
+            accounted[first+i]=canonical[i];++cursor;
+        }
+        return count!=0;
+    }
+    void consume(const int32_t * ids, size_t count, std::vector<uint32_t> & hot){consume_at(cursor,ids,count,hot);}
+};
