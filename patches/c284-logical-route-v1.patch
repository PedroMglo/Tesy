+// Single-context greedy research policy; real ubatch positions supplied before execution.
+void llama_moe_stream::logical_reset(const void * owner, int32_t sequence) {
+    std::lock_guard<std::mutex> lk(mtx);
+    logical_owner=owner;logical_sequence=sequence;++logical_lifecycle;logical_event_serial=0;
+    for(auto & sl:layers)if(sl)sl->logical_route.reset(logical_lifecycle,sequence,sl->route_hotness);
+}
+void llama_moe_stream::logical_begin(const void * owner, int32_t sequence, const std::vector<int32_t> & positions, const std::vector<int32_t> & output_positions) {
+    if(owner!=logical_owner||sequence!=logical_sequence)logical_reset(owner,sequence);
+    std::lock_guard<std::mutex> lk(mtx);
+    GGML_ASSERT(logical_event_serial!=UINT64_MAX);++logical_event_serial;
+    try {
+        for(auto & sl:layers)if(sl)sl->logical_route.begin(logical_event_serial,sl->il==35?output_positions:positions);
+    }catch(const std::exception & e){GGML_ABORT("LOGICAL_ROUTE_V1 begin: %s",e.what());}
+}
+static void c284_account(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n) {
+    GGML_ASSERT(n>=0&&n%4==0);
+    try {sl.logical_route.consume(ids,size_t(n/4),sl.route_hotness);}
+    catch(const std::exception & e){GGML_ABORT("LOGICAL_ROUTE_V1 consume: %s",e.what());}
+}
