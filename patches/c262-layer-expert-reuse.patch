diff --git a/src/c262-expert-tiles.h b/src/c262-expert-tiles.h
new file mode 100644
index 00000000..b56551d4
--- /dev/null
+++ b/src/c262-expert-tiles.h
@@ -0,0 +1,68 @@
+#pragma once
+// Private C262 graph boundary, shared by the native model and model-free test.
+#include "llama-moe-stream.h"
+#include "ggml.h"
+#include <algorithm>
+#include <functional>
+#include <string>
+#include <vector>
+inline ggml_tensor * c262_expert_tiles(ggml_context * ctx0,ggml_cgraph * gf,
+        llama_moe_stream_layer * msl,ggml_tensor * cur,ggml_tensor * selected_experts,
+        int n_tokens,int n_embd,int n_expert,int n_expert_used,bool reuse,
+        const std::function<ggml_tensor*(ggml_tensor*,ggml_tensor*,ggml_tensor*)> & gemms,
+        const std::function<void(ggml_tensor*)> & cb) {
+    GGML_ASSERT(msl && n_tokens>32 && n_tokens<=153 && n_expert_used==4 && msl->n_slots==40);
+        const int tiles = (n_tokens + 31)/32;
+        std::vector<ggml_tensor *> logical(tiles), inputs(tiles), sums(tiles,nullptr);
+        std::vector<int> counts(tiles);
+        for (int t = 0; t < tiles; ++t) {
+            const int first = t*32, count = std::min<int>(32,n_tokens-first);
+            counts[t] = count;
+            logical[t] = ggml_cont(ctx0, ggml_view_2d(ctx0, selected_experts,
+                    n_expert_used,count,selected_experts->nb[1],first*selected_experts->nb[1]));
+            inputs[t] = ggml_cont(ctx0, ggml_view_3d(ctx0,cur,n_embd,1,count,
+                    cur->nb[1],cur->nb[2],first*cur->nb[2]));
+        }
+        ggml_tensor * previous_group = nullptr;
+        const int groups = reuse ? 1 : tiles;
+        for (int group = 0; group < groups; ++group) {
+            const int first = reuse ? 0 : group, last = reuse ? tiles : group+1;
+            auto * all_ids = logical[first]; int tokens = counts[first];
+            for (int t=first+1;t<last;++t) {
+                all_ids=ggml_concat(ctx0,all_ids,logical[t],1); tokens+=counts[t];
+            }
+            all_ids=ggml_cont(ctx0,all_ids);
+            const uint32_t capacity=(msl->n_slots-n_expert_used)/2;
+            const uint32_t waves=(std::min<uint32_t>(n_expert,tokens*n_expert_used)+capacity-1)/capacity;
+            ggml_tensor * previous=previous_group;
+            for (uint32_t w=0;w<waves;++w) {
+                ggml_tensor * args[2]={all_ids,previous};
+                auto * physical=ggml_custom_4d(ctx0,GGML_TYPE_I32,n_expert_used,tokens,1,1,
+                        args,previous?2:1,llama_moe_stream_wave_ids,1,msl->wave_userdata(w,capacity));
+                cb(physical);
+                ggml_tensor * margs[2]={all_ids,physical};
+                auto * mask=ggml_custom_4d(ctx0,GGML_TYPE_F32,1,n_expert_used,tokens,1,
+                        margs,2,llama_moe_stream_wave_mask,1,msl->wave_userdata(w,capacity));
+                int offset=0;ggml_tensor * dependency=nullptr;
+                for(int t=first;t<last;++t) {
+                    auto * pi=ggml_cont(ctx0,ggml_view_2d(ctx0,physical,n_expert_used,counts[t],
+                            physical->nb[1],offset*physical->nb[1]));
+                    auto * ma=ggml_view_3d(ctx0,mask,1,n_expert_used,counts[t],
+                            mask->nb[1],mask->nb[2],offset*mask->nb[2]);
+                    auto * value=ggml_mul(ctx0,gemms(inputs[t],pi,logical[t]),ma);
+                    sums[t]=sums[t]?ggml_add(ctx0,sums[t],value):value;
+                    ggml_set_name(sums[t],("c262-tile-"+std::to_string(t)+"-wave-"+std::to_string(w)).c_str());
+                    ggml_build_forward_expand(gf,sums[t]);
+                    // Every tile consumer precedes replacement of this group.
+                    auto * scalar=ggml_view_1d(ctx0,sums[t],1,0);
+                    dependency=dependency?ggml_concat(ctx0,dependency,scalar,0):scalar;
+                    offset+=counts[t];
+                }
+                previous=dependency;
+            }
+            previous_group=previous;
+        }
+        auto * experts=sums[0];
+        for(int t=1;t<tiles;++t)experts=ggml_concat(ctx0,experts,sums[t],2);
+        return ggml_cont(ctx0,experts);
+}
