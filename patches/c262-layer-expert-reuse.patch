+        mctx = memory->init_batch(*balloc, layer_span, output_all);
         if (!mctx) {
             return -2;
         }
@@ -2361,6 +2378,12 @@ uint32_t llama_context::graph_max_nodes(uint32_t n_tokens) const {
         const uint32_t n_touch_max = std::min<uint32_t>(model.hparams.n_expert, n_tokens*n_eu);
         const uint32_t n_waves = (n_touch_max + cap - 1)/cap;
         res += 24u*n_waves*(uint32_t) mstream->layers.size();
+        if (cparams.c262_layer_span) {
+            // Each wave must keep dependencies to every mature numerical tile.
+            // Bound includes full FFN nodes, views/cont copies and all-tile barrier.
+            const uint32_t tiles = (cparams.c262_layer_span + 31)/32;
+            res += 64u*n_waves*tiles*(uint32_t) mstream->layers.size();
+        }
     }
     return res;
 }
@@ -3660,6 +3683,18 @@ void llama_detach_threadpool(llama_context * ctx) {
     ctx->detach_threadpool();
 }
 
+bool llama_context::c262_set_layer_mode(int32_t mode) {
+    if (!cparams.c262_layer_span || mode < 0 || mode > 2) return false;
+    synchronize();
+    cparams.c262_layer_mode = mode;
+    if (gf_res_prev) gf_res_prev->reset(); // Never reuse another topology at the same shape.
+    return true;
+}
+
+bool llama_c262_set_layer_mode(llama_context * ctx, int32_t mode) {
+    return ctx && ctx->c262_set_layer_mode(mode);
+}
+
 void llama_set_n_threads(llama_context * ctx, int32_t n_threads, int32_t n_threads_batch) {
     ctx->set_n_threads(n_threads, n_threads_batch);
 }
